# Flask / backend configuration
SECRET_KEY=random-value
TURNSTILE_KEY=cloudflare-turnstile-site-key
TURNSTILE_SECRET=cloudflare-turnstile-secret-key
OPENAI_API_KEY=openai-api-key

# Clerk auth / user management
CLERK_SECRET_KEY=clerk-backend-secret
CLERK_JWKS_URL=https://your-clerk-domain/.well-known/jwks.json
# Discord integration
DISCORD_CLIENT_ID=discord-oauth-client-id
DISCORD_CLIENT_SECRET=discord-oauth-client-secret
DISCORD_BOT_TOKEN=discord-bot-token
DISCORD_GUILD_ID=discord-guild-id
DISCORD_JOIN_REDIRECT=https://your-app.example.com/api/discord/join/callback
DISCORD_APPEAL_URL=https://discord.gg/invite-code

# CORS and moderation
CORS_ALLOWED_ORIGINS=https://itlearn.be,https://it-learn.pages.dev,http://localhost:5500,http://127.0.0.1:5500
BIO_MOD_ADMIN_USER_IDS=clerk-user-id-1,clerk-user-id-2

# AI proxy / rate limiting
AI_ALLOWED_PATH_PREFIXES=/practice,/lesson,/ai
AI_MAX_PROMPT_CHARS=40000
AI_MAX_MESSAGES=50
AI_TIMEOUT_SECONDS=40
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_RATE_LIMIT_MAX_REQUESTS=20

# Supabase / database migration helper
SUPABASE_URL=https://otgkiqornzlqceurjnse.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://myapp:your-password@host:5432/myapp_db
